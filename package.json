{
  "name": "@rupayan-das/request-guard",
  "version": "1.0.0",
  "description": "Redis-based rate limiting and semantic caching for Node.js application",
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "test": "vitest",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },

  "keywords": [
    "rate-limiter",
    "rate-limit",
    "redis",
    "semantic-cache",
    "typescript"
  ],

  "author": "Rupayan Das",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "redis": "^6.2.1"
  },

  "engines": {
    "node": ">=20"
  }
}